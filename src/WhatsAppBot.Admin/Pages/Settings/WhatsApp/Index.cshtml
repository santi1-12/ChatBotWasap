@page
@model WhatsAppBot.Admin.Pages.Settings.WhatsApp.IndexModel
@using WhatsAppBot.Shared.Enums
@{
    ViewData["Title"] = "WhatsApp Business";
    var integration = Model.Integration;
    var hasStandardSignup = !string.IsNullOrWhiteSpace(integration?.EmbeddedSignupConfigId);
    var hasCoexistenceSignup = hasStandardSignup
        || !string.IsNullOrWhiteSpace(integration?.CoexistenceEmbeddedSignupConfigId);
    var canStartSignup = !string.IsNullOrWhiteSpace(integration?.MetaAppId)
        && (hasStandardSignup || hasCoexistenceSignup)
        && !string.IsNullOrWhiteSpace(integration.MetaGraphApiVersion)
        && !Model.IsConnected;
}

<div class="page-heading">
    <div>
        <span class="eyebrow">INTEGRACIONES</span>
        <h1>WhatsApp Business</h1>
        <p class="page-subtitle">Conecta un número empresarial mediante la autorización oficial de Meta.</p>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
}
@if (!string.IsNullOrWhiteSpace(Model.PendingMessage))
{
    <div class="alert alert-warning" role="status">@Model.PendingMessage</div>
}
@if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
{
    <div class="alert alert-success" role="status">@Model.SuccessMessage</div>
}

<section class="content-card">
    <div class="d-flex justify-content-between align-items-start gap-3">
        <div>
            <span class="eyebrow">ESTADO DE LA CONEXIÓN</span>
            <h2 class="h4 mt-2">@Model.ConnectionLabel(integration?.ConnectionState)</h2>
            <p class="text-muted mb-0">
                @if (Model.IsConnected && integration is not null)
                {
                    <span>El número se autorizó y vinculó mediante Meta Embedded Signup.</span>
                }
                else
                {
                    <span>Escribir un número no lo conecta. Completa la autorización y verificación de Meta.</span>
                }
            </p>
        </div>
        <span class="badge @(Model.IsConnected ? "text-bg-success" : "text-bg-secondary")">
            @Model.ConnectionLabel(integration?.ConnectionState)
        </span>
    </div>

    @if (Model.IsConnected && integration is not null)
    {
        <hr />
        <dl class="row mb-3">
            <dt class="col-sm-4">Número empresarial</dt>
            <dd class="col-sm-8">@(integration.BusinessPhoneNumber ?? "No informado")</dd>
            <dt class="col-sm-4">Nombre mostrado</dt>
            <dd class="col-sm-8">@(integration.DisplayName ?? "No informado")</dd>
            <dt class="col-sm-4">WABA ID</dt>
            <dd class="col-sm-8"><code>@integration.WabaId</code></dd>
            <dt class="col-sm-4">Phone Number ID</dt>
            <dd class="col-sm-8"><code>@integration.PhoneNumberId</code></dd>
            <dt class="col-sm-4">Bot</dt>
            <dd class="col-sm-8">@(integration.BotEnabled ? "Activo" : "Inactivo")</dd>
        </dl>
        <form method="post" asp-page-handler="Disconnect">
            <button type="submit" class="btn btn-outline-danger">Desconectar WhatsApp</button>
        </form>
    }
    else
    {
        <hr />
        @if (canStartSignup)
        {
            <p>Selecciona cómo está usando el número la empresa. La autorización y la verificación siempre se completan en Meta.</p>
            <div class="mb-3">
                <label class="form-label" for="onboardingTypeSelector">Tipo de conexión</label>
                <select id="onboardingTypeSelector" class="form-select">
                    @if (hasStandardSignup)
                    {
                        <option value="@WhatsAppOnboardingType.Standard">Standard Cloud API</option>
                    }
                    @if (hasCoexistenceSignup)
                    {
                        <option value="@WhatsAppOnboardingType.Coexistence">WhatsApp Business App Coexistence</option>
                    }
                </select>
                <div class="form-text">
                    Coexistence permite vincular un número que continúa activo en WhatsApp Business App,
                    cuando Meta habilita esta opción para la empresa.
                </div>
            </div>
            <button id="connectMeta" type="button" class="btn btn-primary">Conectar WhatsApp Business</button>
            <p id="signupStatus" class="small text-muted mt-3" role="status"></p>
            <form id="completeSignup" method="post" asp-page-handler="CompleteSignup" class="d-none">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="AuthorizationCode" />
                <input type="hidden" asp-for="WabaId" />
                <input type="hidden" asp-for="PhoneNumberId" />
                <input type="hidden" asp-for="OnboardingType" />
            </form>
        }
        else if (Model.ShowConfigurationMissing)
        {
            <div class="alert alert-warning mb-0">
                El Embedded Signup no está configurado. Configura Meta:AppId, Meta:GraphApiVersion
                y al menos una configuración autorizada para Standard o Coexistence en el API.
            </div>
        }
    }
</section>

@if (canStartSignup)
{
    <script src="~/js/meta-embedded-signup-events.js" asp-append-version="true"></script>
    <script>
        const metaAppId = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(integration!.MetaAppId));
        const standardConfigId = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(integration.EmbeddedSignupConfigId));
        const coexistenceConfigId = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(integration.CoexistenceEmbeddedSignupConfigId));
        const graphVersion = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(integration.MetaGraphApiVersion));
        const signupTypeSelector = document.getElementById("onboardingTypeSelector");
        const connectButton = document.getElementById("connectMeta");
        let authorizationCode = null;
        let selectedAssets = null;
        let activeOnboardingType = null;
        let completionSubmitted = false;

        window.fbAsyncInit = function () {
            FB.init({ appId: metaAppId, cookie: true, xfbml: false, version: graphVersion });
        };

        (function (document, script, id) {
            if (document.getElementById(id)) return;
            const sdk = document.createElement(script);
            sdk.id = id;
            sdk.src = "https://connect.facebook.net/en_US/sdk.js";
            document.head.appendChild(sdk);
        })(document, "script", "facebook-jssdk");

        function finishSignupWhenReady() {
            if (!authorizationCode || !selectedAssets || !selectedAssets.wabaId || completionSubmitted) return;
            document.getElementById("AuthorizationCode").value = authorizationCode;
            document.getElementById("WabaId").value = selectedAssets.wabaId;
            document.getElementById("PhoneNumberId").value = selectedAssets.phoneNumberId || "";
            document.getElementById("OnboardingType").value = activeOnboardingType;
            document.getElementById("signupStatus").textContent = "Finalizando conexión segura con Meta…";
            completionSubmitted = true;
            document.getElementById("completeSignup").requestSubmit();
        }

        function resetSignupAttempt() {
            activeOnboardingType = null;
            authorizationCode = null;
            selectedAssets = null;
            completionSubmitted = false;
            signupTypeSelector.disabled = false;
            connectButton.disabled = false;
        }

        window.addEventListener("message", function (event) {
            if (!MetaEmbeddedSignupEvents.isTrustedMetaOrigin(event.origin)) return;
            const signupEvent = MetaEmbeddedSignupEvents.classifyMessage(event.data);
            if (!signupEvent) return;
            if (signupEvent === "CANCEL" || signupEvent === "ERROR") {
                document.getElementById("signupStatus").textContent = "El proceso de Meta se canceló o no se completó.";
                resetSignupAttempt();
                return;
            }
            if (!MetaEmbeddedSignupEvents.matchesOnboardingType(signupEvent, activeOnboardingType)) {
                document.getElementById("signupStatus").textContent =
                    "Meta finalizó un flujo distinto al seleccionado. No se procesó la conexión.";
                resetSignupAttempt();
                return;
            }
            const message = typeof event.data === "string" ? JSON.parse(event.data) : event.data;
            const data = message.data || {};
            selectedAssets = {
                wabaId: data.waba_id || data.wabaId,
                phoneNumberId: data.phone_number_id || data.phoneNumberId
            };
            if (!selectedAssets.wabaId) {
                document.getElementById("signupStatus").textContent =
                    "Meta no devolvió el WABA ID requerido para validar la conexión.";
                return;
            }
            finishSignupWhenReady();
        });

        document.getElementById("connectMeta").addEventListener("click", function () {
            if (!window.FB) {
                document.getElementById("signupStatus").textContent = "No se pudo cargar el SDK de Meta.";
                return;
            }
            activeOnboardingType = signupTypeSelector.value;
            signupTypeSelector.disabled = true;
            connectButton.disabled = true;
            document.getElementById("signupStatus").textContent = "Esperando autorización y selección de activos en Meta…";
            FB.login(function (response) {
                authorizationCode = response?.authResponse?.code || null;
                if (!authorizationCode) {
                    document.getElementById("signupStatus").textContent = "Meta no devolvió un código de autorización.";
                    resetSignupAttempt();
                    return;
                }
                finishSignupWhenReady();
            }, {
                config_id: activeOnboardingType === "@WhatsAppOnboardingType.Coexistence"
                    ? coexistenceConfigId
                    : standardConfigId,
                response_type: "code",
                override_default_response_type: true,
                extras: activeOnboardingType === "@WhatsAppOnboardingType.Coexistence"
                    ? { setup: {}, featureType: "whatsapp_business_app_onboarding" }
                    : { setup: {} }
            });
        });
    </script>
}
