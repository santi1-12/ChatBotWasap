@using System.Security.Claims
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · WhatsAppBot</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="app-shell">
    <aside class="sidebar">
        <a class="brand-lockup" asp-page="/Index"><span class="brand-mark small">W</span><span>WhatsApp<span class="brand-light">Bot</span></span></a>
        <div class="sidebar-label">ESPACIO DE TRABAJO</div>
        <nav class="side-nav">
            <a class="side-link @(ViewContext.RouteData.Values["page"]?.ToString() == "/Index" ? "active" : "")" asp-page="/Index"><span>▦</span> Dashboard</a>
            <a class="side-link @(ViewContext.RouteData.Values["page"]?.ToString()?.StartsWith("/Conversations", StringComparison.Ordinal) == true ? "active" : "")" asp-page="/Conversations/Index"><span>◉</span> Conversaciones</a>
            <div class="sidebar-label mt-4">CONFIGURACIÓN</div>
            <a class="side-link @(ViewContext.RouteData.Values["page"]?.ToString()?.StartsWith("/Settings/WhatsApp", StringComparison.Ordinal) == true ? "active" : "")" asp-page="/Settings/WhatsApp/Index"><span>◎</span> WhatsApp Business</a>
            <a class="side-link @(ViewContext.RouteData.Values["page"]?.ToString()?.StartsWith("/Settings/Bot", StringComparison.Ordinal) == true ? "active" : "")" asp-page="/Settings/Bot/Index"><span>⚙</span> Bot</a>
            <a class="side-link @(ViewContext.RouteData.Values["page"]?.ToString()?.StartsWith("/Settings/FrequentResponses", StringComparison.Ordinal) == true ? "active" : "")" asp-page="/Settings/FrequentResponses/Index"><span>≋</span> Respuestas frecuentes</a>
        </nav>
        <div class="sidebar-footer"><span class="status-dot"></span> Entorno de desarrollo</div>
    </aside>
    <div class="main-column">
        <header class="topbar">
            <div><span class="breadcrumb-muted">WhatsAppBot</span><span class="breadcrumb-separator">/</span><strong>@ViewData["Title"]</strong></div>
            <div class="account-menu">
                <span class="avatar">@((User.FindFirstValue(ClaimTypes.Name)?.FirstOrDefault() ?? 'A').ToString().ToUpperInvariant())</span>
                <span class="account-name">@User.FindFirstValue(ClaimTypes.Name)</span>
                <form method="post" asp-page="/Account/Logout">
                    <button type="submit" class="btn-logout">Cerrar sesión</button>
                </form>
            </div>
        </header>
        <main class="page-content" role="main">@RenderBody()</main>
        <footer class="app-footer">WhatsAppBot · Panel de administración</footer>
    </div>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
