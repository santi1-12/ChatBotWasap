{
  "ConnectionStrings": {
    "WhatsAppBot": ""
  },
  "Authentication": {
    "Issuer": "WhatsAppBot.Api",
    "Audience": "WhatsAppBot.Admin",
    "AccessTokenMinutes": 20
  },
  "Api": {
    "RequestTimeoutSeconds": 30,
    "MaxRequestBodyBytes": 1048576,
    "CompletionFailureStateTimeoutSeconds": 5
  },
  "Meta": {
    "GraphApiVersion": "v24.0",
    "RequestTimeoutSeconds": 30,
    "WebhookMaxBodyBytes": 262144,
    "WorkerBatchSize": 20,
    "MaxPhoneNumberPages": 10
  },
  "Sql": {
    "CommandTimeoutSeconds": 15
  },
  "OpenAI": {
    "ApiKeyReference": "OpenAI:ApiKey",
    "Endpoint": "https://api.openai.com/v1/chat/completions",
    "RequestTimeoutSeconds": 60,
    "MaxInputCharacters": 12000,
    "MaxOutputTokens": 1000,
    "MaxOutputCharacters": 8000,
    "MaxAudioBytes": 25000000,
    "MaxImageBytes": 10000000
  },
  "MediaStorage": {
    "RequestTimeoutSeconds": 30,
    "MaxFileBytes": 25000000,
    "RetentionDays": 30
  },
  "FFmpeg": {
    "TimeoutSeconds": 60,
    "MaxInputBytes": 25000000,
    "MaxOutputBytes": 50000000,
    "MaxDurationSeconds": 300
  },
  "Workers": {
    "PollIntervalSeconds": 1,
    "ItemTimeoutSeconds": 120,
    "MaximumAttempts": 5,
    "RetryBaseDelaySeconds": 5
  },
  "Admin": {
    "ApiBaseUrl": "https://localhost:7001"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
